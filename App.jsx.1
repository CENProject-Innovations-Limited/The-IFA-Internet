// ─── STATS BAR ────────────────────────────────────────────────────────────────

function StatsBar() {
  const stats = [
    { num:256, suffix:'',  label:'Odu Ifa',        sub:'Sacred knowledge codes'         },
    { num:30,  suffix:'+', label:'Platforms',       sub:'Active IFA Internet projects'   },
    { num:8,   suffix:'',  label:'STEAMSEX Fields', sub:'Dimensions of knowledge'        },
    { num:1,   suffix:'',  label:'CEN Universe',    sub:'One unified field of knowledge' },
  ];
  const [counts, setCounts] = useState(stats.map(() => 0));
  const ref = useRef(null);
  useEffect(() => {
    const el = ref.current;
    if (!el) return;
    const obs = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      stats.forEach((s, i) => {
        const end = s.num;
        const step = Math.ceil(end / 40);
        let cur = 0;
        const t = setInterval(() => {
          cur = Math.min(cur + step, end);
          setCounts(prev => { const n = [...prev]; n[i] = cur; return n; });
          if (cur >= end) clearInterval(t);
        }, 28);
      });
      obs.disconnect();
    }, { threshold: 0.5 });
    obs.observe(el);
    return () => obs.disconnect();
  }, []);
  return (
    <div className="ip-stats" ref={ref}>
      <div className="ip-container">
        <div className="ip-stats__grid">
          {stats.map((s, i) => (
            <div key={i} className="ip-stat">
              <div className="ip-stat__num">{counts[i]}{s.suffix}</div>
              <div className="ip-stat__label">{s.label}</div>
              <div className="ip-stat__sub">{s.sub}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}


// ─── ALL PROJECTS SECTION ─────────────────────────────────────────────────────

function AllProjectsSection() {
  const [filter, setFilter] = useState('All');
  const [search, setSearch] = useState('');
  const visible = ALL_PROJECTS.filter(p =>
    (filter === 'All' || p.cat === filter) &&
    (!search || p.name.toLowerCase().includes(search.toLowerCase()) ||
                p.sub.toLowerCase().includes(search.toLowerCase()))
  );
  return (
    <section className="ip-section" id="all">
      <div className="ip-container">
        <div className="ip-eyebrow">IFABOK Universe</div>
        <h2 className="ip-section-title">All IfaProjects</h2>
        <p className="ip-section-sub">
          The complete landscape of IFA Internet projects — 30+ platforms spanning every field of
          knowledge, all grounded in the 256 Odu Ifa and the CEN Unified Field.
        </p>
        <div className="ip-filter-bar">
          <div className="ip-filter-cats">
            {FILTER_CATS.map(c => (
              <button key={c}
                      className={`ip-filter-btn${filter === c ? ' ip-filter-btn--active' : ''}`}
                      onClick={() => setFilter(c)}>
                {c}
              </button>
            ))}
          </div>
          <input className="ip-search" placeholder="Search projects…"
                 value={search} onChange={e => setSearch(e.target.value)} />
        </div>
        {visible.length === 0 && (
          <p className="ip-no-results">No projects found for "{search}" in {filter}.</p>
        )}
        <div className="ip-all-grid">
          {visible.map((p, i) => (
            <a key={i} href={p.href} className="ip-all-card"
               target={p.href.startsWith('http') ? '_blank' : undefined}
               rel={p.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
              <div className="ip-all-card__dot" style={{ background:p.color }}/>
              <div className="ip-all-card__name">{p.name}</div>
              <div className="ip-all-card__sub">{p.sub}</div>
            </a>
          ))}
        </div>
      </div>
    </section>
  );
}


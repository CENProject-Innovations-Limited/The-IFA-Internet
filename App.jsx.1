                 onKeyDown={e => e.key === 'Enter' && setActive(active === i ? null : i)}>
              <div className="ip-discover-card__top">
                <span className="ip-discover-card__emoji">{p.emoji}</span>
                <div>
                  <div className="ip-discover-card__audience" style={{ color:p.color }}>{p.audience}</div>
                  <div className="ip-discover-card__age">{p.age}</div>
                </div>
                <span className="ip-discover-card__toggle" aria-hidden="true">
                  {active === i ? '↑' : '↓'}
                </span>
              </div>
              {active === i && (
                <div className="ip-discover-card__body">
                  <p>{p.desc}</p>
                  <div className="ip-discover-picks">
                    {p.picks.map((pick, j) => (
                      <span key={j} className="ip-pick"
                            style={{ borderColor:`${p.color}55`, color:p.color }}>
                        {pick}
                      </span>
                    ))}
                  </div>
                  <a href={p.href} className="ip-btn ip-btn--primary"
                     style={{ background:p.color, color:'#030608', marginTop:'20px', display:'inline-flex' }}
                     target={p.href.startsWith('http') ? '_blank' : undefined}
                     rel={p.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
                    {p.cta}
                  </a>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  );
}

